# PostgreSQL connection (Railway provides DATABASE_URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/taskflow?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="replace-with-a-strong-secret-at-least-32-chars"

# Public app URL (optional, used for metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
